<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog id="passwordDialog" title="{i18n>user.changePassword}" contentWidth="26rem">
		<MessageStrip id="pwMustChange" text="{i18n>user.mustChange}" type="Warning" showIcon="true"
			class="sapUiSmallMargin" visible="false"/>
		<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="5">
			<Label text="{i18n>user.oldPassword}" required="true"/>
			<Input id="pwOld" type="Password"/>
			<Label text="{i18n>user.newPassword}" required="true"/>
			<Input id="pwNew" type="Password" placeholder="{i18n>user.passwordPolicy}"/>
			<Label text="{i18n>user.repeatPassword}" required="true"/>
			<Input id="pwRepeat" type="Password" submit=".onSavePassword"/>
		</f:SimpleForm>
		<beginButton><Button type="Emphasized" text="{i18n>common.save}" press=".onSavePassword"/></beginButton>
		<endButton><Button text="{i18n>common.cancel}" press=".onClosePassword"/></endButton>
	</Dialog>
</core:FragmentDefinition>
