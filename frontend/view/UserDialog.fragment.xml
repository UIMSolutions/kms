<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog id="userDialog" title="{= ${user>/id} ? ${i18n>user.edit} : ${i18n>user.new} }" contentWidth="32rem">
		<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4">
			<Label text="{i18n>user.username}" required="true"/>
			<Input value="{user>/username}" maxLength="40"/>
			<Label text="{i18n>user.displayName}"/>
			<Input value="{user>/displayName}" maxLength="100"/>
			<Label text="{i18n>user.email}"/>
			<Input value="{user>/email}" type="Email" maxLength="254"/>
			<Label text="{i18n>user.globalRole}" required="true"/>
			<VBox>
				<SegmentedButton selectedKey="{user>/role}">
					<items>
						<SegmentedButtonItem key="user" text="{i18n>role.user}"/>
						<SegmentedButtonItem key="admin" text="{i18n>role.admin}"/>
					</items>
				</SegmentedButton>
				<Text text="{i18n>user.globalRoleHint}" class="sapUiTinyMarginTop"/>
			</VBox>
			<Label text="{i18n>user.active}"/>
			<Switch state="{user>/active}"/>
			<Label text="{i18n>user.initialPassword}" required="true" visible="{= !${user>/id} }"/>
			<Input value="{user>/password}" type="Password" visible="{= !${user>/id} }" placeholder="{i18n>user.passwordPolicy}"/>
			<Label text=""/>
			<CheckBox text="{i18n>user.mustChangePassword}" selected="{user>/mustChangePassword}"/>
		</f:SimpleForm>
		<beginButton><Button type="Emphasized" text="{i18n>common.save}" press=".onSave"/></beginButton>
		<endButton><Button text="{i18n>common.cancel}" press=".onCancel"/></endButton>
	</Dialog>
</core:FragmentDefinition>
