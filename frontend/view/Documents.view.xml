<mvc:View
	controllerName="uim.myfiori.kms.controller.Documents"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:dnd="sap.ui.core.dnd">
	<Page title="{i18n>nav.documents}">
		<headerContent>
			<Button icon="sap-icon://upload" text="{i18n>document.upload}" type="Emphasized" press=".onUpload"
				visible="{session>/isEditor}"/>
		</headerContent>
		<Table id="documentTable" items="{docs>/items}" noDataText="{i18n>document.empty}" sticky="ColumnHeaders,HeaderToolbar"
			class="sapUiResponsiveContentPadding">
			<dragDropConfig>
				<dnd:DropInfo drop=".onDropFiles" enabled="{session>/isEditor}"/>
			</dragDropConfig>
			<headerToolbar>
				<OverflowToolbar>
					<SearchField id="docFilter" width="16rem" placeholder="{i18n>document.searchPlaceholder}" search=".onFilter"/>
					<Select id="docSpace" selectedKey="" change=".onFilter" items="{spaces>/withAll}" forceSelection="true">
						<core:Item key="{spaces>id}" text="{= ${spaces>id} ? ${spaces>name} : ${i18n>common.all} + ' ' + ${i18n>nav.spaces} }"/>
					</Select>
					<Select id="docKind" selectedKey="" change=".onFilter">
						<core:Item key="" text="{i18n>common.all}"/>
						<core:Item key="document" text="{i18n>kind.document}"/>
						<core:Item key="spreadsheet" text="{i18n>kind.spreadsheet}"/>
						<core:Item key="presentation" text="{i18n>kind.presentation}"/>
						<core:Item key="image" text="{i18n>kind.image}"/>
						<core:Item key="video" text="{i18n>kind.video}"/>
						<core:Item key="audio" text="{i18n>kind.audio}"/>
						<core:Item key="archive" text="{i18n>kind.archive}"/>
						<core:Item key="other" text="{i18n>kind.other}"/>
					</Select>
					<ToolbarSpacer/>
					<Select id="docOrder" selectedKey="" change=".onFilter">
						<core:Item key="" text="{i18n>article.order.updated}"/>
						<core:Item key="title" text="{i18n>article.order.title}"/>
						<core:Item key="size desc" text="{i18n>common.size}"/>
						<core:Item key="downloads desc" text="{i18n>document.downloads}"/>
					</Select>
					<Button icon="sap-icon://refresh" tooltip="{i18n>common.refresh}" press=".onFilter"/>
				</OverflowToolbar>
			</headerToolbar>
			<columns>
				<Column width="3rem"/>
				<Column width="40%"><Text text="{i18n>common.title}"/></Column>
				<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>common.space}"/></Column>
				<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>document.kind}"/></Column>
				<Column minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="{i18n>common.size}"/></Column>
				<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>common.tags}"/></Column>
				<Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>common.updated}"/></Column>
				<Column width="3rem" hAlign="End"/>
			</columns>
			<items>
				<ColumnListItem type="Navigation" press=".onOpen">
					<cells>
						<core:Icon src="{parts: [{value: 'document'}, 'docs>kind'], formatter: '.formatter.kindIcon'}" size="1.25rem"/>
						<ObjectIdentifier title="{docs>title}" text="{docs>fileName}"/>
						<Text text="{docs>spaceName}"/>
						<Text text="{path: 'docs>kind', formatter: '.formatter.kindText'}"/>
						<Text text="{path: 'docs>size', formatter: '.formatter.fileSize'}"/>
						<Text text="{path: 'docs>tags', formatter: '.formatter.tagsText'}"/>
						<ObjectAttribute text="{path: 'docs>updatedAt', formatter: '.formatter.relative'} · {docs>uploadedByName}"/>
						<Button icon="sap-icon://download" type="Transparent" tooltip="{i18n>common.download}" press=".onDownloadRow"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		<Button text="{i18n>common.more}" width="100%" press=".onMore" visible="{= ${docs>/items}.length &lt; ${docs>/total} }"/>
	</Page>
</mvc:View>
