<mvc:View
	controllerName="uim.myfiori.kms.controller.Login"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">
	<Page showHeader="false" backgroundDesign="List">
		<FlexBox height="100%" alignItems="Center" justifyContent="Center">
			<VBox class="kmsLoginBox sapUiMediumMargin">
				<HBox alignItems="Center" class="sapUiSmallMarginBottom">
					<core:Icon src="sap-icon://course-book" size="2.5rem" class="sapUiSmallMarginEnd" color="Default"/>
					<Title text="{i18n>appTitle}" level="H1" titleStyle="H2"/>
				</HBox>
				<Text text="{i18n>login.title}" class="sapUiSmallMarginBottom"/>
				<MessageStrip id="loginError" type="Error" showIcon="true" visible="false" class="sapUiSmallMarginBottom"/>
				<Label text="{i18n>login.username}" labelFor="loginUser" required="true"/>
				<Input id="loginUser" autocomplete="false" submit=".onLogin" width="100%"/>
				<Label text="{i18n>login.password}" labelFor="loginPassword" required="true" class="sapUiSmallMarginTop"/>
				<Input id="loginPassword" type="Password" submit=".onLogin" width="100%"/>
				<Button id="loginButton" text="{i18n>login.submit}" type="Emphasized" width="100%" press=".onLogin"
					class="sapUiMediumMarginTop"/>
				<Button text="{i18n>login.sso}" width="100%" visible="{= ${session>/mode} === 'xsuaa' }"
					press=".onSso" class="sapUiSmallMarginTop"/>
			</VBox>
		</FlexBox>
	</Page>
</mvc:View>
