<mvc:View
	controllerName="uim.myfiori.kms.controller.Spaces"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">
	<Page title="{i18n>nav.spaces}">
		<headerContent>
			<Button icon="sap-icon://add" text="{i18n>space.new}" type="Emphasized" press=".onNew" visible="{session>/isAdmin}"/>
		</headerContent>
		<Table items="{spaces>/items}" noDataText="{i18n>space.empty}" class="sapUiResponsiveContentPadding">
			<columns>
				<Column width="3rem"/>
				<Column><Text text="{i18n>common.name}"/></Column>
				<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>space.key}"/></Column>
				<Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>space.articles}"/></Column>
				<Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>space.documents}"/></Column>
				<Column width="7rem" hAlign="End" visible="{session>/isAdmin}"/>
			</columns>
			<items>
				<ColumnListItem type="Navigation" press=".onOpen">
					<cells>
						<core:Icon src="{spaces>icon}" size="1.25rem"/>
						<ObjectIdentifier title="{spaces>name}" text="{spaces>description}"/>
						<Text text="{spaces>key}"/>
						<Link text="{spaces>articleCount}" press=".onOpen"/>
						<Link text="{spaces>documentCount}" press=".onOpenDocuments"/>
						<HBox justifyContent="End">
							<Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>common.edit}" press=".onEdit"/>
							<Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>common.delete}" press=".onDelete"/>
						</HBox>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
	</Page>
</mvc:View>
